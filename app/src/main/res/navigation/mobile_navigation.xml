<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.md.pinjaminapp.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_navigation_home_to_detailBarangFragment"
            app:destination="@id/detailBarangFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_sewakanBarang"
        android:name="com.md.pinjaminapp.ui.sewakanBarang.SewakanBarangFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_sewakanbarang" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.md.pinjaminapp.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_pinjamBarang"
        android:name="com.md.pinjaminapp.ui.pinjamBarang.PinjamBarangFragment"
        android:label="Pinjam Barang"
        tools:layout="@layout/fragment_pinjam_barang"/>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.md.pinjaminapp.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile"/>

    <fragment
        android:id="@+id/detailBarangFragment"
        android:name="com.md.pinjaminapp.ui.pinjamBarang.DetailBarangFragment"
        android:label="Detail Barang"
        tools:layout="@layout/fragment_detail_barang">
        <argument
        android:name="barang"
        app:argType="com.md.pinjaminapp.ui.home.Barang"
        app:nullable="false" /> </fragment>

</navigation>